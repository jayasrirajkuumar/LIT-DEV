generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String                @id @default(uuid()) @db.Uuid
  azureUserId     String                @unique @map("azure_user_id") @db.VarChar(128)
  email           String                @unique @db.VarChar(320)
  displayName     String?               @map("display_name") @db.VarChar(255)
  profilePicture  String?               @map("profile_picture")
  role            UserRole              @default(CUSTOMER)
  isActive        Boolean               @default(true) @map("is_active")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastLogin       DateTime?             @map("last_login") @db.Timestamptz(6)
  phoneNumber     String?               @map("phone_number") @db.VarChar(20)
  giftCardBalance Decimal               @default(0) @map("gift_card_balance") @db.Decimal(12, 2)
  username        String?               @unique @db.VarChar(64)
  addresses       Address[]
  adminAuditLogs  AdminAuditLog[]
  cart            Cart?
  coupons         Coupon[]
  orders          Order[]
  paymentIntents  PaymentIntent[]
  supportReplies         SupportRequestReply[] @relation("SupportReplyAdmin")
  supportRequests        SupportRequest[]
  assignedSupportTickets SupportRequest[]      @relation("AssignedSupportTickets")
  supportMessages        SupportMessage[]
  supportInternalNotes   SupportInternalNote[] @relation("SupportInternalNotes")
  supportActivityLogs    SupportActivityLog[]  @relation("SupportActivityLogs")
  userNotifications      UserNotification[]
  wallet                 Wallet?
  walletTransactions     WalletTransaction[]
  giftCardsSent          GiftCard[]            @relation("GiftCardSender")
  giftCardsReceived      GiftCard[]            @relation("GiftCardRecipient")
  giftCardsRedeemed      GiftCard[]            @relation("GiftCardRedeemer")
  wishlist               Wishlist?

  @@index([email], map: "idx_users_email")
  @@index([azureUserId], map: "idx_users_azure_user_id")
  @@index([role], map: "idx_users_role")
  @@index([isActive], map: "idx_users_is_active")
  @@index([lastLogin], map: "idx_users_last_login")
  @@map("users")
}

model Address {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  fullName     String      @map("full_name") @db.VarChar(255)
  phone        String      @db.VarChar(20)
  addressLine1 String      @map("address_line_1") @db.VarChar(255)
  addressLine2 String?     @map("address_line_2") @db.VarChar(255)
  city         String      @db.VarChar(100)
  state        String      @db.VarChar(100)
  postalCode   String      @map("postal_code") @db.VarChar(20)
  country      String      @db.VarChar(100)
  addressType  AddressType @map("address_type")
  isDefault    Boolean     @default(false) @map("is_default")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_addresses_user_id")
  @@index([userId, isDefault], map: "idx_addresses_user_default")
  @@map("addresses")
}

model Category {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(255)
  slug         String    @unique @db.VarChar(255)
  description  String?
  imageUrl     String?   @map("image_url")
  isActive     Boolean   @default(true) @map("is_active")
  displayOrder Int       @default(0) @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  products     Product[]

  @@index([isActive, displayOrder], map: "idx_categories_active_order")
  @@index([slug], map: "idx_categories_slug")
  @@map("categories")
}

model Product {
  id               String            @id @default(uuid()) @db.Uuid
  categoryId       String            @map("category_id") @db.Uuid
  name             String            @db.VarChar(255)
  slug             String            @unique @db.VarChar(255)
  shortDescription String?           @map("short_description") @db.VarChar(500)
  description      String?
  sku              String            @unique @db.VarChar(64)
  brand            String            @db.VarChar(255)
  price            Decimal           @db.Decimal(12, 2)
  comparePrice     Decimal?          @map("compare_price") @db.Decimal(12, 2)
  currency         String            @default("INR") @db.VarChar(3)
  status           ProductStatus     @default(DRAFT)
  weight           Decimal?          @db.Decimal(10, 3)
  dimensions       Json?
  isFeatured       Boolean           @default(false) @map("is_featured")
  viewCount        Int               @default(0) @map("view_count")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  cartItems        CartItem[]
  orderItems       OrderItem[]
  images           ProductImage[]
  inventory        ProductInventory?
  category         Category          @relation(fields: [categoryId], references: [id])
  wishlistItems    WishlistItem[]

  @@index([categoryId], map: "idx_products_category_id")
  @@index([status], map: "idx_products_status")
  @@index([brand], map: "idx_products_brand")
  @@index([price], map: "idx_products_price")
  @@index([slug], map: "idx_products_slug")
  @@index([isFeatured], map: "idx_products_featured")
  @@index([createdAt], map: "idx_products_created_at")
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  imageUrl  String   @map("image_url")
  altText   String?  @map("alt_text") @db.VarChar(255)
  sortOrder Int      @default(0) @map("sort_order")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder], map: "idx_product_images_product_sort")
  @@map("product_images")
}

model ProductInventory {
  id                String   @id @default(uuid()) @db.Uuid
  productId         String   @unique @map("product_id") @db.Uuid
  quantity          Int      @default(0)
  reservedQuantity  Int      @default(0) @map("reserved_quantity")
  lowStockThreshold Int      @default(5) @map("low_stock_threshold")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([quantity], map: "idx_product_inventory_quantity")
  @@map("product_inventory")
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @unique @map("user_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  items     CartItem[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_carts_user_id")
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId], map: "uq_cart_items_cart_product")
  @@index([cartId], map: "idx_cart_items_cart_id")
  @@index([productId], map: "idx_cart_items_product_id")
  @@map("cart_items")
}

model Wishlist {
  id          String               @id @default(uuid()) @db.Uuid
  userId      String               @unique @map("user_id") @db.Uuid
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  collections WishlistCollection[]
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_wishlists_user_id")
  @@map("wishlists")
}

model WishlistCollection {
  id           String         @id @default(uuid()) @db.Uuid
  wishlistId   String         @map("wishlist_id") @db.Uuid
  name         String         @db.VarChar(255)
  slug         String         @db.VarChar(255)
  isDefault    Boolean        @default(false) @map("is_default")
  displayOrder Int            @default(0) @map("display_order")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  wishlist     Wishlist       @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  items        WishlistItem[]

  @@unique([wishlistId, slug], map: "uq_wishlist_collections_wishlist_slug")
  @@index([wishlistId, displayOrder], map: "idx_wishlist_collections_order")
  @@map("wishlist_collections")
}

model WishlistItem {
  id           String             @id @default(uuid()) @db.Uuid
  productId    String             @map("product_id") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  collectionId String             @map("collection_id") @db.Uuid
  collection   WishlistCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product            @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId], map: "uq_wishlist_items_collection_product")
  @@index([collectionId], map: "idx_wishlist_items_collection_id")
  @@index([productId], map: "idx_wishlist_items_product_id")
  @@map("wishlist_items")
}

model Order {
  id                 String                   @id @default(uuid()) @db.Uuid
  userId             String                   @map("user_id") @db.Uuid
  orderNumber        String                   @unique @map("order_number") @db.VarChar(32)
  subtotal           Decimal                  @db.Decimal(12, 2)
  shippingCharge     Decimal                  @map("shipping_charge") @db.Decimal(12, 2)
  tax                Decimal                  @db.Decimal(12, 2)
  discount           Decimal                  @default(0) @db.Decimal(12, 2)
  grandTotal         Decimal                  @map("grand_total") @db.Decimal(12, 2)
  paymentStatus      PaymentStatus            @map("payment_status")
  orderStatus        OrderStatus              @map("order_status")
  paymentMethod      String?                  @map("payment_method") @db.VarChar(50)
  currency           String                   @default("INR") @db.VarChar(3)
  deliveryMethod     DeliveryMethod?          @map("delivery_method")
  deliveryEstimate   String?                  @map("delivery_estimate") @db.VarChar(255)
  couponCode         String?                  @map("coupon_code") @db.VarChar(64)
  giftMessage        String?                  @map("gift_message")
  orderNotes         String?                  @map("order_notes")
  trackingNumber     String?                  @map("tracking_number") @db.VarChar(128)
  adminNotes         String?                  @map("admin_notes")
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  cancellationReason OrderCancellationReason?
  items              OrderItem[]
  shippingAddress    OrderShippingAddress?
  statusHistory      OrderStatusHistory[]
  user               User                     @relation(fields: [userId], references: [id])
  paymentIntents     PaymentIntent[]
  supportRequests    SupportRequest[]

  @@index([userId], map: "idx_orders_user_id")
  @@index([orderStatus], map: "idx_orders_status")
  @@index([paymentStatus], map: "idx_orders_payment_status")
  @@index([orderNumber], map: "idx_orders_order_number")
  @@index([createdAt], map: "idx_orders_created_at")
  @@map("orders")
}

model OrderItem {
  id                  String  @id @default(uuid()) @db.Uuid
  orderId             String  @map("order_id") @db.Uuid
  productId           String  @map("product_id") @db.Uuid
  productNameSnapshot String  @map("product_name_snapshot") @db.VarChar(255)
  skuSnapshot         String  @map("sku_snapshot") @db.VarChar(64)
  priceSnapshot       Decimal @map("price_snapshot") @db.Decimal(12, 2)
  quantity            Int
  subtotal            Decimal @db.Decimal(12, 2)
  order               Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product @relation(fields: [productId], references: [id])

  @@index([orderId], map: "idx_order_items_order_id")
  @@index([productId], map: "idx_order_items_product_id")
  @@map("order_items")
}

model OrderShippingAddress {
  id           String  @id @default(uuid()) @db.Uuid
  orderId      String  @unique @map("order_id") @db.Uuid
  fullName     String  @map("full_name") @db.VarChar(255)
  phone        String  @db.VarChar(20)
  addressLine1 String  @map("address_line_1") @db.VarChar(255)
  addressLine2 String? @map("address_line_2") @db.VarChar(255)
  city         String  @db.VarChar(100)
  state        String  @db.VarChar(100)
  postalCode   String  @map("postal_code") @db.VarChar(20)
  country      String  @db.VarChar(100)
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_shipping_addresses")
}

model OrderStatusHistory {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String      @map("order_id") @db.Uuid
  status    OrderStatus
  note      String?
  changedBy String?     @map("changed_by") @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt], map: "idx_order_status_history_order_created")
  @@map("order_status_history")
}

model PaymentIntent {
  id           String               @id @default(uuid()) @db.Uuid
  orderId      String               @map("order_id") @db.Uuid
  userId       String               @map("user_id") @db.Uuid
  provider     PaymentProvider
  amount       Decimal              @db.Decimal(12, 2)
  currency     String               @default("INR") @db.VarChar(3)
  status       PaymentStatus
  providerRef  String?              @map("provider_ref") @db.VarChar(255)
  metadata     Json?
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  order        Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user         User                 @relation(fields: [userId], references: [id])
  transactions PaymentTransaction[]

  @@index([orderId], map: "idx_payment_intents_order_id")
  @@index([userId], map: "idx_payment_intents_user_id")
  @@index([status], map: "idx_payment_intents_status")
  @@map("payment_intents")
}

model PaymentTransaction {
  id              String          @id @default(uuid()) @db.Uuid
  paymentIntentId String          @map("payment_intent_id") @db.Uuid
  provider        PaymentProvider
  status          PaymentStatus
  amount          Decimal         @db.Decimal(12, 2)
  currency        String          @default("INR") @db.VarChar(3)
  providerTxnId   String?         @map("provider_txn_id") @db.VarChar(255)
  rawResponse     Json?           @map("raw_response")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  paymentIntent   PaymentIntent   @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)

  @@index([paymentIntentId], map: "idx_payment_transactions_intent_id")
  @@map("payment_transactions")
}

model OrderCancellationReason {
  id         String                 @id @default(uuid()) @db.Uuid
  orderId    String                 @unique @map("order_id") @db.Uuid
  reasonCode CancellationReasonCode @map("reason_code")
  reasonText String?                @map("reason_text")
  createdAt  DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  order      Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([reasonCode], map: "idx_order_cancellation_reason_code")
  @@map("order_cancellation_reasons")
}

model SupportRequest {
  id           String                 @id @default(uuid()) @db.Uuid
  ticketNumber String                 @unique @map("ticket_number") @db.VarChar(20)
  userId       String?                @map("user_id") @db.Uuid
  orderId      String?                @map("order_id") @db.Uuid
  contactName  String                 @map("contact_name") @db.VarChar(255)
  contactEmail String                 @map("contact_email") @db.VarChar(320)
  type         SupportRequestType
  subject      String                 @db.VarChar(255)
  category     String?                @db.VarChar(100)
  message      String
  status       SupportRequestStatus   @default(OPEN)
  priority     SupportRequestPriority @default(MEDIUM)
  assignedToId         String?                @map("assigned_to") @db.Uuid
  lastMessageAt        DateTime?              @map("last_message_at") @db.Timestamptz(6)
  lastMessagePreview   String?                @map("last_message_preview") @db.VarChar(500)
  customerLastOpenedAt DateTime?              @map("customer_last_opened_at") @db.Timestamptz(6)
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  messages             SupportMessage[]
  replies              SupportRequestReply[]
  internalNotes        SupportInternalNote[]
  activityLogs         SupportActivityLog[]
  order                Order?                 @relation(fields: [orderId], references: [id])
  user         User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignedTo   User?                  @relation("AssignedSupportTickets", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt], map: "idx_support_requests_user_created")
  @@index([status], map: "idx_support_requests_status")
  @@index([ticketNumber], map: "idx_support_requests_ticket_number")
  @@index([contactEmail], map: "idx_support_requests_contact_email")
  @@index([priority], map: "idx_support_requests_priority")
  @@index([assignedToId], map: "idx_support_requests_assigned_to")
  @@index([lastMessageAt], map: "idx_support_requests_last_message_at")
  @@map("support_requests")
}

model SupportMessage {
  id             String                   @id @default(uuid()) @db.Uuid
  conversationId String                   @map("conversation_id") @db.Uuid
  senderType     SupportMessageSenderType @map("sender_type")
  senderId       String?                  @map("sender_id") @db.Uuid
  message        String
  attachmentUrl  String?                  @map("attachment_url")
  attachmentType String?                  @map("attachment_type") @db.VarChar(32)
  isRead         Boolean                  @default(false) @map("is_read")
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  conversation   SupportRequest           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User?                    @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt], map: "idx_support_messages_conversation_created")
  @@index([conversationId, isRead], map: "idx_support_messages_conversation_read")
  @@map("support_messages")
}

model SupportInternalNote {
  id             String         @id @default(uuid()) @db.Uuid
  conversationId String         @map("conversation_id") @db.Uuid
  adminUserId    String         @map("admin_user_id") @db.Uuid
  note           String
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation   SupportRequest @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  adminUser      User           @relation("SupportInternalNotes", fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt], map: "idx_support_internal_notes_conversation")
  @@map("support_internal_notes")
}

model SupportActivityLog {
  id             String         @id @default(uuid()) @db.Uuid
  conversationId String         @map("conversation_id") @db.Uuid
  adminUserId    String?        @map("admin_user_id") @db.Uuid
  action         String         @db.VarChar(64)
  message        String
  metadata       Json?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation   SupportRequest @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  adminUser      User?          @relation("SupportActivityLogs", fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt], map: "idx_support_activity_conversation")
  @@map("support_activity_logs")
}

model UserNotification {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  type       String   @db.VarChar(64)
  title      String   @db.VarChar(255)
  message    String
  entityType String?  @map("entity_type") @db.VarChar(64)
  entityId   String?  @map("entity_id") @db.VarChar(128)
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt], map: "idx_user_notifications_user_unread")
  @@map("user_notifications")
}

model AdminAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  adminUserId String?  @map("admin_user_id") @db.Uuid
  action      String   @db.VarChar(64)
  entityType  String?  @map("entity_type") @db.VarChar(64)
  entityId    String?  @map("entity_id") @db.VarChar(128)
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  admin       User?    @relation(fields: [adminUserId], references: [id])

  @@index([createdAt], map: "idx_admin_audit_created")
  @@index([action], map: "idx_admin_audit_action")
  @@map("admin_audit_logs")
}

model AdminNotification {
  id         String   @id @default(uuid()) @db.Uuid
  type       String   @db.VarChar(64)
  title      String   @db.VarChar(255)
  message    String
  entityType String?  @map("entity_type") @db.VarChar(64)
  entityId   String?  @map("entity_id") @db.VarChar(128)
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([isRead, createdAt], map: "idx_admin_notifications_unread")
  @@map("admin_notifications")
}

model StoreSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(128)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("store_settings")
}

model MarketplaceAnnouncement {
  id        String   @id @default(uuid()) @db.Uuid
  message   String   @db.VarChar(500)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive, sortOrder], map: "idx_marketplace_announcements_active")
  @@map("marketplace_announcements")
}

model MarketplaceBrand {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(255)
  logoUrl   String?  @map("logo_url") @db.VarChar(1024)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive, sortOrder], map: "idx_marketplace_brands_active")
  @@map("marketplace_brands")
}

model MarketplaceSortOption {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(64)
  label     String   @db.VarChar(128)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive, sortOrder], map: "idx_marketplace_sort_options_active")
  @@map("marketplace_sort_options")
}

model MarketplaceFilterOption {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(64)
  label     String   @db.VarChar(128)
  type      String   @default("select") @db.VarChar(32)
  config    Json?
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive, sortOrder], map: "idx_marketplace_filter_options_active")
  @@map("marketplace_filter_options")
}

model Coupon {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  code      String       @unique @db.VarChar(64)
  type      CouponType   @default(FLAT)
  amount    Decimal      @db.Decimal(12, 2)
  isUsed    Boolean      @default(false) @map("is_used")
  source    CouponSource @default(WELCOME)
  expiresAt DateTime?    @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?    @map("used_at") @db.Timestamptz(6)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isUsed], map: "idx_coupons_user_used")
  @@map("coupons")
}

model GiftCard {
  id               String                 @id @default(uuid()) @db.Uuid
  giftCardCode     String                 @unique @map("gift_card_code") @db.VarChar(24)
  pinHash          String?                @map("pin_hash") @db.VarChar(128)
  senderId         String?                @map("sender_id") @db.Uuid
  recipientId      String?                @map("recipient_id") @db.Uuid
  senderName       String                 @map("sender_name") @db.VarChar(255)
  recipientName    String                 @map("recipient_name") @db.VarChar(255)
  recipientEmail   String?                @map("recipient_email") @db.VarChar(320)
  recipientPhone   String?                @map("recipient_phone") @db.VarChar(20)
  amount           Decimal                @db.Decimal(12, 2)
  remainingBalance Decimal                @map("remaining_balance") @db.Decimal(12, 2)
  currency         String                 @default("INR") @db.VarChar(3)
  message          String?
  occasion         String                 @db.VarChar(64)
  theme            String                 @db.VarChar(64)
  deliveryMethod   GiftCardDeliveryMethod @default(EMAIL) @map("delivery_method")
  deliveryType     GiftCardDeliveryType   @default(INSTANT) @map("delivery_type")
  scheduledAt      DateTime?              @map("scheduled_at") @db.Timestamptz(6)
  timezone         String?                @db.VarChar(64)
  status           GiftCardStatus         @default(PENDING_PAYMENT)
  claimStatus      GiftCardClaimStatus    @default(PENDING) @map("claim_status")
  paymentStatus    PaymentStatus          @default(PENDING) @map("payment_status")
  isInternal       Boolean                @default(true) @map("is_internal")
  redeemedAt       DateTime?              @map("redeemed_at") @db.Timestamptz(6)
  claimedAt        DateTime?              @map("claimed_at") @db.Timestamptz(6)
  declinedAt       DateTime?              @map("declined_at") @db.Timestamptz(6)
  redeemedById     String?                @map("redeemed_by") @db.Uuid
  expiryDate       DateTime               @map("expiry_date") @db.Timestamptz(6)
  qrCodeData       String?                @map("qr_code_data")
  platformFee      Decimal                @default(0) @map("platform_fee") @db.Decimal(12, 2)
  gstAmount        Decimal                @default(0) @map("gst_amount") @db.Decimal(12, 2)
  discountAmount   Decimal                @default(0) @map("discount_amount") @db.Decimal(12, 2)
  couponCode       String?                @map("coupon_code") @db.VarChar(64)
  grandTotal       Decimal                @map("grand_total") @db.Decimal(12, 2)
  paymentProvider  PaymentProvider?       @map("payment_provider")
  providerRef      String?                @map("provider_ref") @db.VarChar(255)
  emailSentAt      DateTime?              @map("email_sent_at") @db.Timestamptz(6)
  deliveredAt      DateTime?              @map("delivered_at") @db.Timestamptz(6)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  sender           User?                  @relation("GiftCardSender", fields: [senderId], references: [id], onDelete: SetNull)
  recipient        User?                  @relation("GiftCardRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  redeemedBy       User?                  @relation("GiftCardRedeemer", fields: [redeemedById], references: [id], onDelete: SetNull)
  activityLogs     GiftCardActivityLog[]
  transactions     GiftCardTransaction[]

  @@index([recipientEmail], map: "idx_gift_cards_recipient_email")
  @@index([recipientId], map: "idx_gift_cards_recipient_id")
  @@index([status], map: "idx_gift_cards_status")
  @@index([claimStatus], map: "idx_gift_cards_claim_status")
  @@index([senderId, createdAt], map: "idx_gift_cards_sender_created")
  @@index([scheduledAt, status], map: "idx_gift_cards_scheduled")
  @@map("gift_cards")
}

model GiftCardActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  giftCardId String   @map("gift_card_id") @db.Uuid
  action     String   @db.VarChar(64)
  message    String
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  giftCard   GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)

  @@index([giftCardId, createdAt], map: "idx_gift_card_activity")
  @@map("gift_card_activity_logs")
}

model GiftCardTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique @db.VarChar(64)
  name      String   @db.VarChar(128)
  imageUrl  String?  @map("image_url")
  gradient  String?
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive, sortOrder], map: "idx_gift_card_templates_active")
  @@map("gift_card_templates")
}

model Wallet {
  id            String              @id @default(uuid()) @db.Uuid
  userId        String              @unique @map("user_id") @db.Uuid
  walletBalance Decimal             @default(0) @map("wallet_balance") @db.Decimal(12, 2)
  totalCredits  Decimal             @default(0) @map("total_credits") @db.Decimal(12, 2)
  totalDebits   Decimal             @default(0) @map("total_debits") @db.Decimal(12, 2)
  isFrozen      Boolean             @default(false) @map("is_frozen")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  WalletTransaction[]

  @@index([userId], map: "idx_wallets_user_id")
  @@map("wallets")
}

model WalletTransaction {
  id            String                @id @default(uuid()) @db.Uuid
  walletId      String                @map("wallet_id") @db.Uuid
  userId        String                @map("user_id") @db.Uuid
  type          WalletTransactionType
  amount        Decimal               @db.Decimal(12, 2)
  balanceAfter  Decimal               @map("balance_after") @db.Decimal(12, 2)
  referenceType String?               @map("reference_type") @db.VarChar(64)
  referenceId   String?               @map("reference_id") @db.VarChar(128)
  description   String
  metadata      Json?
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  wallet        Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt], map: "idx_wallet_tx_user_created")
  @@index([walletId, createdAt], map: "idx_wallet_tx_wallet_created")
  @@map("wallet_transactions")
}

model GiftCardTransaction {
  id                  String           @id @default(uuid()) @db.Uuid
  giftCardId          String           @map("gift_card_id") @db.Uuid
  userId              String           @map("user_id") @db.Uuid
  type                String           @db.VarChar(32)
  amount              Decimal          @db.Decimal(12, 2)
  paymentProvider     PaymentProvider? @map("payment_provider")
  providerRef         String?          @map("provider_ref") @db.VarChar(255)
  walletTransactionId String?          @map("wallet_transaction_id") @db.Uuid
  metadata            Json?
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  giftCard            GiftCard         @relation(fields: [giftCardId], references: [id], onDelete: Cascade)

  @@index([giftCardId, createdAt], map: "idx_gift_card_tx_card")
  @@index([userId, createdAt], map: "idx_gift_card_tx_user")
  @@map("gift_card_transactions")
}

model SupportRequestReply {
  id               String         @id @default(uuid()) @db.Uuid
  supportRequestId String         @map("support_request_id") @db.Uuid
  adminUserId      String?        @map("admin_user_id") @db.Uuid
  message          String
  channel          String         @default("EMAIL") @db.VarChar(32)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  adminUser        User?          @relation("SupportReplyAdmin", fields: [adminUserId], references: [id])
  supportRequest   SupportRequest @relation(fields: [supportRequestId], references: [id], onDelete: Cascade)

  @@index([supportRequestId, createdAt], map: "idx_support_replies_request")
  @@map("support_request_replies")
}

