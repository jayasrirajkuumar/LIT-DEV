{
  "name": "lit-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LIT marketplace API — user management and Azure External ID provisioning",
  "main": "server.js",
  "scripts": {
    "dev": "node scripts/free-port.js 3001 && node server.js",
    "dev:watch": "node scripts/free-port.js 3001 && node --watch server.js",
    "start": "node server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "node scripts/with-azure-db.js migrate dev",
    "prisma:migrate:deploy": "node scripts/with-azure-db.js migrate deploy",
    "prisma:studio": "node scripts/with-azure-db.js studio",
    "prisma:seed": "node scripts/with-azure-db.js db seed",
    "verify:foundation": "node scripts/verify-foundation.js",
    "verify:startup": "node scripts/verify-startup.js",
    "verify:azure-db": "node scripts/verify-azure-db.js",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.33.0",
    "@prisma/client": "^6.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jose": "^6.0.11",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "socket.io": "^4.8.3",
    "xlsx": "^0.18.5",
    "zod": "^3.25.36"
  },
  "devDependencies": {
    "prisma": "^6.9.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
